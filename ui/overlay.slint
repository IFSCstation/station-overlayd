// Importing the TTF makes slint-build pre-rasterize the glyphs of this file
// into the generated code (renderer-software build pass), so the runtime
// never loads a font from disk or from fontconfig.
//
// Note: Slint parses 8-hex-digit colors as #RRGGBBAA, so #000000cc is
// transparent black (alpha 0xcc ≈ 80%).

import "fonts/Roboto-Regular.ttf";

export component Overlay inherits Window {
    // Full-screen background; transparent where nothing is painted so the
    // desktop shows through (shm buffer starts zeroed = transparent).
    background: transparent;
    default-font-family: "Roboto";

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
    }

    // Centralized bottom bar with 3 placeholder buttons.
    // Bottom padding keeps the buttons clear of the screen's bottom edge.
    Rectangle {
        width: parent.width;
        height: 64px;
        y: parent.height - 64px;
        background: #00000077;

        // 3 × 120 px buttons + 2 × 16 px gaps = 392 px wide; centered.
        Rectangle {
            x: parent.width / 2 - 196px;
            y: 12px;
            width: 120px;
            height: 40px;
            background: #2a2a2a;
            Text {
                text: "Button 1";
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: parent.width / 2 - 60px;
            y: 12px;
            width: 120px;
            height: 40px;
            background: #2a2a2a;
            Text {
                text: "Button 2";
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: parent.width / 2 + 76px;
            y: 12px;
            width: 120px;
            height: 40px;
            background: #2a2a2a;
            Text {
                text: "Button 3";
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

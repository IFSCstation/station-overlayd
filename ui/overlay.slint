// Importing the TTF makes slint-build pre-rasterize the glyphs of this file
// into the generated code (renderer-software build pass), so the runtime
// never loads a font from disk or from fontconfig.
//
// Two fonts are embedded:
//   - Roboto-Regular: UI text font (default-font-family)
//   - MaterialSymbolsRounded: subsetted icon font (home, speaker/volume, close)
//     used by the bottom bar buttons.
//
// Note: Slint parses 8-hex-digit colors as #RRGGBBAA, so #000000cc is
// transparent black (alpha 0xcc ≈ 80%).

import "fonts/Roboto-Regular.ttf";
import "fonts/MaterialSymbolsRounded.ttf";

export component Overlay inherits Window {
    // Index of the currently focused bottom-bar button
    // (0 = home, 1 = speaker/volume, 2 = power, 3 = close).
    // Updated from Rust on gamepad nav.
    in-out property <int> focused_button: 0;
    // Current local time, formatted by Rust as "HH:MM".
    in property <string> clock_text: "";

    // Speaker/volume submenu. When true and the speaker button (index 1) is
    // focused, a small window appears on top of that button with a volume
    // slider. Toggled from Rust on button activation (BTN_SOUTH).
    in-out property <bool> speaker_submenu_open: false;
    // Volume level 0..=100. Driven by the submenu slider and synced to the OS.
    in-out property <int> volume_level: 50;

    // Power submenu. Uses the exact same window geometry/style as the volume
    // submenu (above the power button, index 2). Lets the user shut down or
    // reboot; the selected entry is confirmed with BTN_SOUTH.
    in-out property <bool> power_submenu_open: false;
    // Selected entry: 0 = shutdown, 1 = reboot.
    in-out property <int> power_selection: 0;

    // Set to true by Rust when the overlay is shown; drives the bottom bar's
    // entrance animation (lean in from below the screen edge). Reset to false
    // when hidden so the next show re-animates.
    in-out property <bool> show_animation: false;

    // Full-screen background; transparent where nothing is painted so the
    // desktop shows through (shm buffer starts zeroed = transparent).
    background: transparent;
    default-font-family: "Roboto";

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
    }

    // Clock in the top-right corner. The text is set from Rust and refreshed
    // once per minute (the timer polls every second).
    Text {
        x: 0;
        y: 16px;
        width: parent.width - 24px;
        height: 40px;
        text: clock_text;
        font-size: 30px;
        color: #ffffff;
        horizontal-alignment: right;
        vertical-alignment: top;
    }

    // Centralized bottom bar with 3 placeholder circle buttons.
    // Bottom padding keeps the buttons clear of the screen's bottom edge.
    // Leans up from below the screen edge when the overlay is invoked.
    Rectangle {
        width: parent.width;
        height: 96px;
        // Off-screen (below the bottom edge) until the entrance animation runs.
        y: show_animation ? parent.height - 96px : parent.height;
        animate y {
            duration: 300ms;
            easing: ease-out;
        }
        // background: #00000077; (transparent)

        // 4 × 64px circle buttons + 3 × 16px gaps = 304px wide; centered.
        // border-radius = half the size makes the rectangle a circle.
        // Order: 0 = home, 1 = speaker/volume, 2 = power, 3 = close.
        Rectangle {
            x: parent.width / 2 - 152px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            // Focused button: bright accent fill plus a white ring so the
            // selection is obvious at a glance (dark grey when unfocused).
            background: focused_button == 0 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 0 ? 3px : 0px;
            border-color: #ffffff;

            Text {
                text: "\u{e9b2}"; // home
                font-family: "Material Symbols Rounded";
                font-size: 48px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width / 2 - 72px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: focused_button == 1 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 1 ? 3px : 0px;
            border-color: #ffffff;

            Text {
                text: "\u{e04f}"; // speaker / volume
                font-family: "Material Symbols Rounded";
                font-size: 48px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width / 2 + 8px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: focused_button == 2 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 2 ? 3px : 0px;
            border-color: #ffffff;

            // Power icon drawn from primitives (the embedded icon font is
            // subsetted to home/speaker/close only): a ring with a gap at the
            // top and a vertical stem through it.
            Rectangle {
                x: 16px;
                y: 20px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                border-width: 3px;
                border-color: #ffffff;
                background: transparent;
            }
            // Mask the top of the ring to leave the classic power gap.
            Rectangle {
                x: 25px;
                y: 14px;
                width: 14px;
                height: 14px;
                background: focused_button == 2 ? #3d8bff : #2a2a2a;
            }
            // Vertical stem.
            Rectangle {
                x: 30px;
                y: 12px;
                width: 4px;
                height: 22px;
                background: #ffffff;
            }
        }

        Rectangle {
            x: parent.width / 2 + 88px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: focused_button == 3 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 3 ? 3px : 0px;
            border-color: #ffffff;

            Text {
                text: "\u{e5cd}"; // close
                font-family: "Material Symbols Rounded";
                font-size: 48px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Speaker / volume submenu: a small window on top of the speaker button
    // (button index 1). Shows a volume slider navigable with left/right.
    Rectangle {
        visible: speaker_submenu_open && focused_button == 1;
        // Speaker button top is at parent.height - 96px + 16px = parent.height - 80px.
        // Place the submenu just above it, centered on the button.
        x: parent.width / 2 - 70px;
        y: parent.height - 80px - 160px - 10px;
        width: 140px;
        height: 160px;
        background: #2a2a2a;
        border-width: 2px;
        border-color: #5ac8fa;

        Text {
            text: "VOLUME";
            font-family: "Roboto";
            font-size: 16px;
            color: #ffffff;
            x: 12px;
            y: 14px;
        }

        // Volume value readout.
        Text {
            text: volume_level;
            font-family: "Roboto";
            font-size: 14px;
            color: #b8b8c8;
            x: parent.width - 24px;
            y: 14px;
            horizontal-alignment: right;
        }

        // Slider track.
        Rectangle {
            x: 20px;
            y: 64px;
            width: 100px;
            height: 6px;
            background: #555555;
        }

        // Slider thumb; position maps volume_level (0..=100) onto the track.
        Rectangle {
            x: 20px + (volume_level * 100px) / 100 - 6px;
            y: 64px - 4px;
            width: 12px;
            height: 14px;
            background: focused_button == 1 && speaker_submenu_open ? #3d8bff : #ffffff;
        }
    }

    // Power submenu: exact same window geometry/style as the volume submenu,
    // centered on the power button (index 2). Up/down selects, BTN_SOUTH
    // confirms the shutdown/reboot action.
    Rectangle {
        visible: power_submenu_open && focused_button == 2;
        // Power button center sits 40px right of the bar center; the window
        // is 140px wide, so x = center + 40 - 70 = center - 30.
        x: parent.width / 2 - 30px;
        y: parent.height - 80px - 160px - 10px;
        width: 140px;
        height: 160px;
        background: #2a2a2a;
        border-width: 2px;
        border-color: #5ac8fa;

        Text {
            text: "POWER";
            font-family: "Roboto";
            font-size: 16px;
            color: #ffffff;
            x: 12px;
            y: 14px;
        }

        // Shutdown entry.
        Rectangle {
            x: 10px;
            y: 46px;
            width: parent.width - 20px;
            height: 40px;
            border-radius: 6px;
            background: power_selection == 0 ? #3d8bff : transparent;

            Text {
                text: "Shutdown";
                font-family: "Roboto";
                font-size: 16px;
                color: #ffffff;
                x: 12px;
                y: 0px;
                width: parent.width - 24px;
                height: parent.height;
                vertical-alignment: center;
            }
        }

        // Reboot entry.
        Rectangle {
            x: 10px;
            y: 92px;
            width: parent.width - 20px;
            height: 40px;
            border-radius: 6px;
            background: power_selection == 1 ? #3d8bff : transparent;

            Text {
                text: "Reboot";
                font-family: "Roboto";
                font-size: 16px;
                color: #ffffff;
                x: 12px;
                y: 0px;
                width: parent.width - 24px;
                height: parent.height;
                vertical-alignment: center;
            }
        }
    }
}

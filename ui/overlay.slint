// Importing the TTF makes slint-build pre-rasterize the glyphs of this file
// into the generated code (renderer-software build pass), so the runtime
// never loads a font from disk or from fontconfig.
//
// Two fonts are embedded:
//   - Roboto-Regular: UI text font (default-font-family)
//   - MaterialSymbolsRounded: subsetted icon font (home, settings, close)
//     used by the bottom bar buttons.
//
// Note: Slint parses 8-hex-digit colors as #RRGGBBAA, so #000000cc is
// transparent black (alpha 0xcc ≈ 80%).

import "fonts/Roboto-Regular.ttf";
import "fonts/MaterialSymbolsRounded.ttf";

export component Overlay inherits Window {
    // Index of the currently focused bottom-bar button
    // (0 = home, 1 = settings, 2 = close). Updated from Rust on gamepad nav.
    in-out property <int> focused_button: 0;
    // Current local time, formatted by Rust as "HH:MM".
    in property <string> clock_text: "";

    // Full-screen background; transparent where nothing is painted so the
    // desktop shows through (shm buffer starts zeroed = transparent).
    background: transparent;
    default-font-family: "Roboto";

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;
    }

    // Clock in the top-right corner. The text is set from Rust and refreshed
    // once per minute (the timer polls every second).
    Text {
        x: 0;
        y: 16px;
        width: parent.width - 24px;
        height: 40px;
        text: clock_text;
        font-size: 30px;
        color: #ffffff;
        horizontal-alignment: right;
        vertical-alignment: top;
    }

    // Centralized bottom bar with 3 placeholder circle buttons.
    // Bottom padding keeps the buttons clear of the screen's bottom edge.
    Rectangle {
        width: parent.width;
        height: 96px;
        y: parent.height - 96px;
        // background: #00000077; (transparent)

        // 3 × 64px circle buttons + 2 × 16px gaps = 224px wide; centered.
        // border-radius = half the size makes the rectangle a circle.
        Rectangle {
            x: parent.width / 2 - 112px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            // Focused button: bright accent fill plus a white ring so the
            // selection is obvious at a glance (dark grey when unfocused).
            background: focused_button == 0 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 0 ? 3px : 0px;
            border-color: #ffffff;

            Text {
                text: "\u{e9b2}"; // home
                font-family: "Material Symbols Rounded";
                font-size: 48px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width / 2 - 32px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: focused_button == 1 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 1 ? 3px : 0px;
            border-color: #ffffff;

            Text {
                text: "\u{e8b8}"; // settings
                font-family: "Material Symbols Rounded";
                font-size: 48px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width / 2 + 48px;
            y: 16px;
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: focused_button == 2 ? #3d8bff : #2a2a2a;
            border-width: focused_button == 2 ? 3px : 0px;
            border-color: #ffffff;

            Text {
                text: "\u{e5cd}"; // close
                font-family: "Material Symbols Rounded";
                font-size: 48px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

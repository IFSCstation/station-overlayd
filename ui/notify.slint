// Notification module UI (M4). Shows a temporary notification message.

import "fonts/Roboto-Regular.ttf";

export component NotifyWindow inherits Window {
    background: transparent;
    default-font-family: "Roboto";

    in property <string> notify_text: "";

    Rectangle {
        width: 400px;
        height: 80px;
        x: parent.width / 2 - 200px;
        y: parent.height - 120px;
        background: #d9101018;
        border-radius: 8px;
        border-width: 1px;
        border-color: #5ac8fa;

        Text {
            text: root.notify_text;
            font-family: "Roboto";
            font-size: 16px;
            color: #ffffff;
            x: 16px;
            y: parent.height / 2 - self.height - 2px;
            width: parent.width - 32px;
            horizontal-alignment: center;
        }
    }
}

[Unit]
Description=overlayd - Lightweight Wayland overlay daemon
Documentation=man:overlayd(1)
# graphical-session.target is reached when a graphical (Wayland/X11) session
# is active. This target exists in user systemd instances.
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/overlayd
Restart=on-failure
RestartSec=5
# XDG_RUNTIME_DIR is already set correctly by the systemd user manager
# (/run/user/<uid>); do NOT override it with %i (that is the username).
# WAYLAND_DISPLAY falls back to wayland-0 inside the daemon if unset.
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_CONFIG_HOME=%h/.config

[Install]
WantedBy=graphical-session.target
